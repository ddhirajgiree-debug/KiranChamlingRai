@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Biography";
}

<style>
    /* =========================================
           DARK THEME STYLES (Matching Hero Section)
           ========================================= */
    :root {
        --bg-dark: #0b1320; /* Deep Navy Blue */
        --bg-card: #152238; /* Slightly lighter for cards */
        --theme-gold: #d4af37; /* Golden text & buttons */
        --text-main: #ffffff;
        --text-muted: #a0aabf;
    }

    /* यहाँ body को सट्टा wrapper राखिएको छ ताकि Navbar सेतो/कालो नहोस् */
    .bio-wrapper {
        background-color: var(--bg-dark);
        color: var(--text-main);
        font-family: 'Georgia', 'Mukta', serif;
        min-height: 100vh;
        padding-top: 1rem;
    }

    .bio-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
    }

    /* Header */
    .bio-header {
        text-align: center;
        margin-bottom: 4rem;
    }

        .bio-header h1 {
            font-size: 3rem;
            font-weight: 400;
            margin-top: 0.5rem;
            margin-bottom: 1.5rem;
            color: var(--text-main);
        }

    /* Profile Layout (Text Left, Photo Right) */
    .bio-profile {
        display: grid;
        grid-template-columns: 1fr 400px;
        gap: 4rem;
        margin-bottom: 5rem;
        align-items: center;
    }

    .bio-text p {
        font-size: 1.1rem;
        line-height: 1.9;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        text-align: justify;
    }

    .bio-text strong {
        color: var(--text-main);
    }

    .bio-photo img {
        width: 100%;
        height: auto;
        border-radius: 15px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
        border: 2px solid rgba(212, 175, 55, 0.2);
        object-fit: cover;
    }

    /* Awards Section */
    .awards-section {
        margin-bottom: 5rem;
    }

    .awards-title {
        display: flex;
        align-items: center;
        font-size: 1.6rem;
        font-weight: 600;
        margin-bottom: 2rem;
        color: var(--text-main);
    }

        .awards-title::before {
            content: '🏆';
            margin-right: 12px;
            font-size: 1.3rem;
        }

    .award-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    .award-card {
        background: var(--bg-card);
        border: 1px solid #23324d;
        padding: 1.8rem;
        border-radius: 10px;
        position: relative;
        transition: all 0.3s ease;
    }

        .award-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            border-color: rgba(212, 175, 55, 0.4);
        }

        .award-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--theme-gold);
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .award-card h3 {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 0.7rem;
            color: var(--theme-gold);
        }

        .award-card p {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin: 0;
        }

    /* Photo Gallery Grid */
    .bio-gallery {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-top: 2rem;
    }

        .bio-gallery img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            filter: grayscale(80%) brightness(0.8);
            transition: all 0.3s ease;
            border-radius: 8px;
        }

            .bio-gallery img:hover {
                filter: grayscale(0%) brightness(1);
                transform: scale(1.02);
            }

    /* Responsive */
    @@media (max-width: 991px) {
        .bio-profile {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .bio-photo {
            order: -1;
            max-width: 350px;
            margin: 0 auto;
        }

        .bio-text p {
            text-align: center;
        }

        .award-grid {
            grid-template-columns: 1fr;
        }

        .bio-gallery {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<!-- =========================================
     WRAPPER START (Background यहाँ लागू हुन्छ)
     ========================================= -->
<div class="bio-wrapper">
    <div class="bio-container">

        <!-- Header (मात्र शीर्षक, तलको बटन हटाइयो) -->
        <div class="bio-header">
            <h1 data-en="Biography" data-ne="जीवनी">Biography</h1>
        </div>

        <!-- Profile: Text Left, Photo Right -->
        <div class="bio-profile">

            <!-- Left Side: Text Content -->
            <div class="bio-text">
                <!-- ENGLISH & NEPALI CONTENT (data-en / data-ne प्रयोग गरियो) -->
                <p>
                    <strong data-en="Kiran Chamling Rai" data-ne="किरण चाम्लिङ राई">Kiran Chamling Rai</strong>
                    <span data-en=" is an established Nepali theatre and film artist, playwright, actor, and director. He was born to Hast Bir Rai and Madhu Chamling Rai in Kurumba, Miklajung Rural Municipality–5, Panchthar District, eastern Nepal. He has been continuously active in Nepali theatre and cinema for over two decades."
                          data-ne=" नेपाली नाट्य तथा चलचित्र उद्योगमा एक स्थापित नाटककार, अभिनेता तथा निर्देशक हुन्। उनको जन्म बुवा हस्त वीर राई र आमा मधु चाम्लिङ राईको कोखबाट पूर्वी नेपालको पाँचथर जिल्ला, मिक्लाजुङ गाउँपालिका–५, कुरुम्बामा भएको हो। उनी विगत दुई दशकदेखि नेपाली नाट्य तथा चलचित्र उद्योगमा निरन्तर कार्यरत छन्।">
                        is an established Nepali theatre and film artist, playwright, actor, and director. He was born to Hast Bir Rai and Madhu Chamling Rai in Kurumba, Miklajung Rural Municipality–5, Panchthar District, eastern Nepal. He has been continuously active in Nepali theatre and cinema for over two decades.
                    </span>
                </p>
                <p data-en="Known for staging original narratives rooted in Kirati civilization, Mundhum tradition, and social reality, his work bridges literature, community memory, and contemporary performance. His notable productions include Lato Pahad (2016), Jokhana (2019), Khuwalung (2022), and Bakhamma (2024)."
                   data-ne="किराती सभ्यता, मुन्दुमी परम्परा र सामाजिक यथार्थमा आधारित मौलिक कथा मञ्चनका लागि परिचित उनको कामले साहित्य, सामुदायिक स्मृति र समकालीन प्रस्तुति बीचको सेतु निर्माण गर्दछ। उनले निर्देशन गरेका चर्चित नाटकहरूमा लाटो पहाड (२०१६), जोखना (२०१९), खुवालुङ (२०२२) र बाखाम्मा (२०२४) रहेका छन्।">
                    Known for staging original narratives rooted in Kirati civilization, Mundhum tradition, and social reality, his work bridges literature, community memory, and contemporary performance. His notable productions include Lato Pahad (2016), Jokhana (2019), Khuwalung (2022), and Bakhamma (2024).
                </p>
                <p data-en="Beyond theatre direction, he has worked as a chief assistant director on Nepali feature films such as Jari, Mansara, Rimai, and Jari 2. His theatre acting credits include Nari, Ke Lageu Halkale, Majipa Lakhe, and Damini Bhir."
                   data-ne="नाटक निर्देशन बाहेक, उनले जारी, मनसरा, रिमै र जारी–२ जस्ता नेपाली कथानक चलचित्रमा मुख्य सहायक निर्देशकको रूपमा काम गरेका छन्। उनले अभिनय गरेका नाटकहरूमा नारी, के लगेउ हल्काले, मजिपा लाखे र दमिनी भीर पर्दछन्।">
                    Beyond theatre direction, he has worked as a chief assistant director on Nepali feature films such as Jari, Mansara, Rimai, and Jari 2. His theatre acting credits include Nari, Ke Lageu Halkale, Majipa Lakhe, and Damini Bhir.
                </p>
                <p data-en="He has also acted in films including Dhok, Saili, Mansara, and Senako Cheli. He directed dozens of music videos and was honored with the Gopal Prasad Rimal National Award in 2025."
                   data-ne="उनले दोख, साइलि, मनसरा र नेपाली सेनाको चेली जस्ता चलचित्रमा पनि अभिनय गरेका छन्। उनले दर्जनौँ म्युजिक भिडियो निर्देशन गर्नुका साथै सन् २०२५ मा गोपाल प्रसाद रिमाल राष्ट्रिय पुरस्कारबाट सम्मानित भएका छन्।">
                    He has also acted in films including Dhok, Saili, Mansara, and Senako Cheli. He directed dozens of music videos and was honored with the Gopal Prasad Rimal National Award in 2025.
                </p>
            </div>

            <!-- Right Side: Photo -->
            <div class="bio-photo">
                <img src="~/images/kiran-biography.jpeg" alt="Kiran Chamling Rai" />
            </div>
        </div>

        <!-- Awards & Honors Section -->
        <div class="awards-section">
            <h2 class="awards-title">
                <span data-en="Awards & Honors" data-ne="पुरस्कार तथा सम्मान">Awards & Honors</span>
            </h2>

            <div class="award-grid">

                <!-- Award 1 -->
                <div class="award-card">
                    <h3 data-en="Gopal Prasad Rimal National Award" data-ne="गोपाल प्रसाद रिमाल राष्ट्रिय पुरस्कार">Gopal Prasad Rimal National Award</h3>
                    <p data-en="Received in 2025 for outstanding contributions to Nepali theatre and performing arts." data-ne="नेपाली रंगमञ्चमा पुर्‍याएको महत्त्वपूर्ण योगदानको कदर गर्दै सन् २०२५ मा प्रदान गरिएको।">
                        Received in 2025 for outstanding contributions to Nepali theatre and performing arts.
                    </p>
                </div>

                <!-- Award 2 -->
                <div class="award-card">
                    <h3 data-en="Major Theatre Productions" data-ne="प्रमुख नाट्य निर्देशनहरू">Major Theatre Productions</h3>
                    <p data-en="Recognized for directing critically acclaimed plays including Jokhana, Khuwalung, and Bakhamma." data-ne="जोखना, खुवालुङ र बाखाम्मा जस्ता समालोचकबाट प्रशंसित नाटकहरूको निर्देशनका लागि परिचित।">
                        Recognized for directing critically acclaimed plays including Jokhana, Khuwalung, and Bakhamma.
                    </p>
                </div>

                <!-- Award 3 -->
                <div class="award-card">
                    <h3 data-en="Film & Media Recognition" data-ne="चलचित्र तथा सञ्चारमाध्यम">Film & Media Recognition</h3>
                    <p data-en="Contributed as Chief Assistant Director to hit films like Jari and Mansara." data-ne="जारी र मनसरा जस्ता सफल चलचित्रमा मुख्य सहायक निर्देशकको रूपमा योगदान।">
                        Contributed as Chief Assistant Director to hit films like Jari and Mansara.
                    </p>
                </div>

                <!-- Award 4 -->
                <div class="award-card">
                    <h3 data-en="Theatre Training & Mentorship" data-ne="रंगमञ्च तालिम तथा प्रशिक्षण">Theatre Training & Mentorship</h3>
                    <p data-en="Conducted 20-day and 12-day theatre training programs in Jhapa and Kailali to mentor new talents." data-ne="नयाँ प्रतिभालाई प्रोत्साहन गर्न झापा र कैलालीमा २० दिने र १२ दिने नाट्य तालिम सञ्चालन।">
                        Conducted 20-day and 12-day theatre training programs in Jhapa and Kailali to mentor new talents.
                    </p>
                </div>

            </div>
        </div>

        <!-- Photo Gallery (Bottom) -->
        <div class="bio-gallery">
            <img src="~/images/theatre-performance.jpg" alt="Theatre Performance" />
            <img src="~/images/directing_a_play.jpg" alt="Directing a Play" />
            <img src="~/images/behind.jpg" alt="Behind the Scenes" />
            <img src="~/images/portrait.jpg" alt="Portrait" />
        </div>

    </div>
</div>

<!-- =========================================
     JAVASCRIPT (Global Navbar लाई सपोर्ट गर्न)
     ========================================= -->
@section Scripts {
    <script>
        // पेज लोड हुँदा LocalStorage बाट भाषा पढ्ने
        document.addEventListener('DOMContentLoaded', () => {
            // तपाईंको Global Script ले setLanguage(lang) कल गर्छ।
            // यदि पहिले नै भाषा सेभ भएको छ भने, त्यो लोड गर्ने।
            const savedLang = localStorage.getItem("kiranPortfolioLanguage") || "en";

            // Global Function कल गर्ने (यदि तपाईंको site.js मा छ भने)
            if (typeof setLanguage === "function") {
                setLanguage(savedLang);
            }
        });
    </script>
}