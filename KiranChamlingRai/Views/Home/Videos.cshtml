@{
    ViewData["Title"] = "Videos & Interviews | भिडियो तथा अन्तर्वार्ता";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .media-page-wrapper {
        background-color: #0b1320;
        color: #fff;
        min-height: 100vh;
        padding: 5rem 1.5rem;
        font-family: 'Mukta', sans-serif;
    }

    .media-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .media-header {
        text-align: center;
        margin-bottom: 4rem;
    }

        .media-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            color: #fff;
            margin-bottom: 1rem;
        }

        .media-header p {
            color: #a0aabf;
            font-size: 1.1rem;
        }

    /* =========================================
           FEATURED VIDEO (मुख्य भिडियो)
           ========================================= */
    .featured-video {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 0;
        background: #152238; /* 👈 सेतोबाट गाढा नीलो बनाइयो */
        border: 1px solid #23324d;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 4rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .featured-thumb {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #000;
        cursor: pointer;
        display: block;
    }

        .featured-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .featured-thumb iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .featured-thumb .play-button {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 70px;
            height: 50px;
            background: rgba(255, 0, 0, 0.9);
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            transition: background 0.3s ease;
        }

        .featured-thumb:hover .play-button {
            background: #ff0000;
        }

    .featured-info {
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .featured-info h2 {
            color: #ffffff; /* 👈 शीर्षक सेतो बनाइयो */
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .featured-info p {
            color: #a0aabf; /* 👈 विवरण फिक्का खैरो बनाइयो */
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .featured-info .watch-button {
            display: inline-block;
            text-align: center;
            padding: 0.8rem 2rem;
            border: 1px solid #d4af37; /* 👈 सुनौलो बोर्डर */
            color: #d4af37; /* 👈 सुनौलो अक्षर */
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
            align-self: flex-start;
        }

            .featured-info .watch-button:hover {
                background: #d4af37;
                color: #0b1320;
            }

    /* =========================================
           MORE VIDEOS GRID
           ========================================= */
    .more-videos-title {
        color: #d4af37;
        font-size: 1.5rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid #23324d;
        padding-bottom: 0.5rem;
        display: inline-block;
    }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    .video-card {
        background: #152238; /* 👈 कार्डको ब्याकग्राउन्ड गाढा नीलो */
        border: 1px solid #23324d;
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }

        .video-card:hover {
            transform: translateY(-5px);
            border-color: rgba(212, 175, 55, 0.4);
        }

        .video-card .thumb {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #000;
            cursor: pointer;
            display: block;
        }

            .video-card .thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .video-card .thumb iframe {
                width: 100%;
                height: 100%;
                border: none;
            }

            .video-card .thumb .play-button {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 60px;
                height: 42px;
                background: rgba(255, 0, 0, 0.9);
                color: white;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.5rem;
                transition: background 0.3s ease;
            }

        .video-card:hover .thumb .play-button {
            background: #ff0000;
        }

        .video-card .info {
            padding: 1.5rem;
            background: #152238; /* 👈 कन्टेन्टको ब्याकग्राउन्ड पनि गाढा नीलो */
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .video-card h3 {
            color: #ffffff; /* 👈 शीर्षक सेतो */
            font-size: 1.2rem;
            margin-bottom: 0.5rem;
            line-height: 1.4;
            font-weight: 700;
            font-family: 'Playfair Display', serif;
        }

        .video-card p {
            color: #a0aabf; /* 👈 विवरण फिक्का खैरो */
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 1.5rem;
            flex-grow: 1;
        }

    .watch-btn {
        display: block;
        text-align: center;
        padding: 0.8rem;
        border: 1px solid #d4af37; /* 👈 सुनौलो बोर्डर */
        color: #d4af37; /* 👈 सुनौलो अक्षर */
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: auto;
        background: transparent;
        width: 100%;
        cursor: pointer;
        font-family: inherit;
    }

        .watch-btn:hover {
            background: #d4af37;
            color: #0b1320;
        }

    /* Responsive */
    @@media (max-width: 900px) {
        .featured-video {
            grid-template-columns: 1fr;
        }

        .featured-info {
            padding: 1.5rem;
        }

            .featured-info .watch-button {
                align-self: stretch;
            }
    }
</style>

