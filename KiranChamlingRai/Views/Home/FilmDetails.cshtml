@{
    ViewData["Title"] = "Film Details | चलचित्रको विवरण";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string filmId = ViewBag.FilmId as string ?? "";

    string filmTitleEn = "";
    string filmTitleNp = "";
