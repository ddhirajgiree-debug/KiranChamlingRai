@{
    ViewData["Title"] = "Film & Direction | चलचित्र तथा निर्देशन";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* =========================================
               FILM & DIRECTION PAGE STYLES
               ========================================= */
    .fd-page-wrapper {
        background-color: #0b1320;
        color: #ffffff;
        min-height: 100vh;
        padding: 5rem 1.5rem;
        font-family: 'Georgia', 'Mukta', serif;
    }

    .fd-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Header */
    .fd-header {
        text-align: center;
        margin-bottom: 5rem;
    }

        .fd-header span.kicker {
            color: #d4af37;
            font-size: 0.85rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .fd-header h1 {
            font-size: 3rem;
            margin-top: 0.5rem;
            margin-bottom: 1rem;
            font-family: 'Playfair Display', serif;
        }

        .fd-header p {
            color: #a0aabf;
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
        }

    /* =========================================
               MAIN FEATURED WORKS
               ========================================= */
    .fd-featured-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-bottom: 5rem;
    }

    .fd-featured-card {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 0;
        background: #152238;
        border: 1px solid #23324d;
        border-radius: 15px;
        overflow: hidden;
        transition: all 0.3s ease;
        align-items: stretch;
    }

        .fd-featured-card:hover {
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            border-color: rgba(212, 175, 55, 0.4);
        }

    .fd-featured-image {
        width: 100%;
        height: 100%;
        min-height: 250px;
        max-height: 300px;
        object-fit: cover;
        background-color: #1a2332; /* फोटो लोड हुँदै गर्दा देखिने रंग */
    }

    .fd-featured-content {
        padding: 2rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .fd-featured-content .fd-year {
            color: #d4af37;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .fd-featured-content h3 {
            color: #ffffff;
            font-size: 1.8rem;
            font-family: 'Playfair Display', serif;
            margin-top: 0;
            margin-bottom: 1rem;
        }

        .fd-featured-content p {
            color: #a0aabf;
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 1rem;
            text-align: justify;
        }

    /* 👇 Read More Button (थिएटर जस्तै) */
    .read-more-btn {
        display: inline-block;
        padding: 0.6rem 1.5rem;
        background: #0b1320;
        border: 1px solid #23324d;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-decoration: none;
        transition: all 0.3s ease;
        cursor: pointer;
        text-align: center;
        margin-top: 1rem;
        align-self: flex-start;
        font-family: 'Mukta', sans-serif;
    }

        .read-more-btn:hover {
            background: #d4af37;
            color: #0b1320;
            border-color: #d4af37;
        }

    /* =========================================
               INFO BOXES (For TV & Radio)
               ========================================= */
    .fd-section-title {
        color: #d4af37;
        font-size: 1.8rem;
        font-family: 'Playfair Display', serif;
        margin-bottom: 2rem;
        border-bottom: 1px solid #23324d;
        padding-bottom: 0.5rem;
        display: inline-block;
    }

    .fd-info-box {
        background: rgba(212, 175, 55, 0.05);
        border-left: 4px solid #d4af37;
        padding: 2rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

        .fd-info-box h4 {
            color: #d4af37;
            font-size: 1.3rem;
            font-family: 'Playfair Display', serif;
            margin-top: 0;
            margin-bottom: 1rem;
        }

        .fd-info-box p {
            color: #d1d5db;
            font-size: 1.05rem;
            line-height: 1.8;
            margin: 0;
            text-align: justify;
        }

    /* Responsive */
    @@media (max-width: 900px) {
        .fd-featured-card {
            grid-template-columns: 1fr;
        }

        .fd-featured-image {
            min-height: 200px;
            max-height: 250px;
        }

        .fd-featured-content {
            padding: 2rem;
        }

            .fd-featured-content h3 {
                font-size: 1.6rem;
            }
    }
</style>

