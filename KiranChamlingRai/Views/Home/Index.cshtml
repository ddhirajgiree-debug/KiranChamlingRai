    <!-- =========================================
     EXPERIENCE SECTION STYLES
     ========================================= -->
    <style>
            .exp-section {
                padding: 5rem 1.5rem;
                background-color: #0b1320;
            }

            .exp-container {
                max-width: 1200px;
                margin: 0 auto;
            }

            .exp-header {
                margin-bottom: 3rem;
            }

                .exp-header h2 {
                    font-family: 'Playfair Display', serif;
                    font-size: 2.5rem;
                    color: #ffffff;
                    margin-bottom: 0.5rem;
                }

            .exp-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
                gap: 2rem;
            }

            /* आकर्षक कार्ड डिजाइन */
            .exp-card {
                background: linear-gradient(145deg, #152238, #101a2b);
                border: 1px solid #23324d;
                border-radius: 12px;
                padding: 2rem;
                position: relative;
                overflow: hidden;
                transition: all 0.4s ease;
                box-shadow: 0 10px 30px rgba(0,0,0,0.2);
                display: flex;
                flex-direction: column;
            }

                /* माथि सुनौलो रेखा (Top Gold Line) */
                .exp-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 3px;
                    background: #d4af37;
                    transform: scaleX(0);
                    transform-origin: left;
                    transition: transform 0.4s ease;
                }

                .exp-card:hover::before {
                    transform: scaleX(1);
                }

                .exp-card:hover {
                    transform: translateY(-8px);
                    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
                    border-color: rgba(212, 175, 55, 0.3);
                }

            /* आइकन बक्स */
            .exp-icon-box {
                width: 50px;
                height: 50px;
                background: rgba(212, 175, 55, 0.1);
                border: 1px solid rgba(212, 175, 55, 0.2);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 1.5rem;
                transition: all 0.4s ease;
            }

            .exp-card:hover .exp-icon-box {
                background: #d4af37;
            }

            /* SVG आइकन */
            .exp-icon-box svg {
                width: 24px;
                height: 24px;
                stroke: #d4af37;
                transition: stroke 0.4s ease;
            }

            .exp-card:hover .exp-icon-box svg {
                stroke: #0b1320; /* Hover गर्दा कालो हुने */
            }

            .exp-card h3 {
                color: #ffffff;
                font-size: 1.3rem;
                font-family: 'Playfair Display', serif;
                margin-bottom: 1rem;
            }

            .exp-card p {
                color: #a0aabf;
                font-size: 0.95rem;
                line-height: 1.7;
                margin: 0;
                flex-grow: 1;
            }
    </style>

    <!-- =========================================
     EXPERIENCE SECTION HTML
     ========================================= -->
