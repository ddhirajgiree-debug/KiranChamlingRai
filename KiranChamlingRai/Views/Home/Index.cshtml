                <!-- 👇 Theatre Works पेजमा जाने -->
                <a asp-controller="Home" asp-action="TheatreWorks" class="btn btn-outline"
                   data-en="Explore My Works" data-ne="मेरा कामहरू">
                    Explore My Works
                </a>
            </div>
        </div>

        <div class="hero-image-wrap">
            <div class="portrait-frame">
                <img src="~/images/kiran-chamling-rai.jpeg"
                     alt="Kiran Chamling Rai, Nepali actor, playwright and director"
                     class="hero-portrait" />
