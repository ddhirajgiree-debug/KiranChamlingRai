@{
    ViewData["Title"] = "Kiran Chamling Rai | Portfolio";
}

<main id="home">
  

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <p class="eyebrow"
               data-en="ACTOR · PLAYWRIGHT · DIRECTOR"
               data-ne="अभिनेता · नाटककार · निर्देशक">
                ACTOR · PLAYWRIGHT · DIRECTOR
            </p>

            <h1 data-en="Kiran Chamling Rai"
                data-ne="किरण चाम्लिङ राई">
                Kiran Chamling Rai
            </h1>

            <h2 data-en="Stories that live on stage and screen."
                data-ne="मञ्च र पर्दामा जीवन्त रहने कथाहरू।">
                Stories that live on stage and screen.
            </h2>

            <p data-en="A Nepali theatre and film artist with a passion for storytelling, performance and direction."
               data-ne="कथा, अभिनय र निर्देशनप्रति समर्पित नेपाली रङ्गमञ्च तथा चलचित्रकर्मी।">
                A Nepali theatre and film artist with a passion for storytelling,
                performance and direction.
            </p>

            <div class="hero-buttons">
                <!-- 👇 Biography पेजमा जाने -->
